{
  "agent_id": "eryl_semantic_rag_agent_chain",
  "description": "Message contracts for Eryl's semantic flow. Agents emit strict JSON where noted (fenced ```json blocks are stripped by callers before json.loads).",
  "entrypoint": "ErylChainRunner.run",
  "inputs": [
    "initial_question",
    "analysis_type",
    "sql_query",
    "sql_answer",
    "updated_question"
  ],
  "outputs": [
    "llm_answer",
    "analysis_type",
    "updated_question"
  ],
  "input_schema": {
    "fields": [
      "initial_question",
      "analysis_type",
      "sql_query",
      "sql_answer",
      "updated_question"
    ]
  },
  "output_schema": {
    "fields": [
      "llm_answer",
      "analysis_type",
      "updated_question"
    ]
  },
  "flow_input_contract": {
    "description": "What Eryl expects when entered. Standalone get_answer() takes a plain question string; ErylChainRunner.run accepts the orchestrator-friendly fields below.",
    "type": "object",
    "required": ["initial_question"],
    "properties": {
      "initial_question": { "type": "string" },
      "analysis_type": {
        "type": "string",
        "enum": ["Semantic-based", "Both-dependent", "Both-independent"],
        "description": "Optional; echoed in runner output for pipeline compatibility. Defaults to Semantic-based."
      },
      "sql_query": {
        "type": ["string", "null"],
        "description": "Optional; retained for downstream pipeline compatibility only."
      },
      "sql_answer": {
        "type": ["string", "null"],
        "description": "Optional; retained for downstream pipeline compatibility only."
      },
      "updated_question": {
        "type": ["string", "null"],
        "description": "When present, used as the question instead of initial_question."
      }
    }
  },
  "flow_output_contract": {
    "description": "What Eryl hands back once critic_agent passes the answer.",
    "type": "object",
    "properties": {
      "question": { "type": "string" },
      "llm_answer": { "type": "string" },
      "analysis_type": { "type": "string" },
      "updated_question": { "type": "string" }
    }
  },
  "message_contracts": {
    "Eryl_agent": {
      "output": {
        "type": "object",
        "required": ["question", "next_agent"],
        "properties": {
          "question": { "type": "string", "description": "Question forwarded to extract_context." },
          "next_agent": { "type": "string", "const": "retriever" }
        }
      },
      "tool_call": {
        "name": "extract_context",
        "args": { "question": "string" }
      }
    },
    "retriever": {
      "output": {
        "type": "object",
        "description": "Result of the extract_context tool call.",
        "properties": {
          "vector_context": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "llm_answer_maker": {
      "output": {
        "type": "string",
        "description": "Free-text answer grounded strictly in the retrieved context, or the literal sentence 'I do not have enough information to answer this question.' when context is insufficient."
      }
    },
    "critic_agent": {
      "output": {
        "type": "object",
        "required": [
          "question",
          "llm_answer",
          "helpfulness",
          "relevance",
          "groundedness",
          "completeness",
          "faithfulness",
          "composite_score",
          "status",
          "feedback_query"
        ],
        "properties": {
          "question": { "type": "string" },
          "llm_answer": { "type": "string" },
          "helpfulness": { "type": "number", "minimum": 0, "maximum": 10 },
          "relevance": { "type": "number", "minimum": 0, "maximum": 10 },
          "groundedness": { "type": "number", "minimum": 0, "maximum": 10 },
          "completeness": { "type": "number", "minimum": 0, "maximum": 10 },
          "faithfulness": { "type": "number", "minimum": 0, "maximum": 10 },
          "composite_score": { "type": "number", "minimum": 0, "maximum": 10 },
          "status": { "type": "string", "enum": ["PASS", "FAIL"] },
          "feedback_query": {
            "type": "string",
            "description": "'None' on PASS; a focused follow-up question on FAIL."
          },
          "feedback_detail": {
            "type": "string",
            "description": "Gap explanation on FAIL."
          }
        },
        "trailing_literal_on_pass": "Happy with the answer"
      }
    }
  },
  "routing_rules": {
    "user_proxy": "-> Eryl_agent",
    "Eryl_agent": "-> retriever",
    "retriever": "-> llm_answer_maker",
    "llm_answer_maker": "-> critic_agent",
    "critic_agent": {
      "contains 'Happy with the answer'": "-> user_proxy (exits Eryl)",
      "otherwise": "-> Eryl_agent (loop, using feedback_query)"
    }
  },
  "termination": {
    "critic_agent.is_termination_msg": "True when the raw message contains the literal substring 'Happy with the answer'."
  }
}
