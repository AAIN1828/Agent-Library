{
  "agent_id": "intake_gateway",
  "name": "Intake Gateway",
  "role": "Question intake and Responsible AI safety gate",
  "description": "Receives the user question, runs a deterministic Azure Content Safety-style pre-check, then an LLM Responsible AI agent for governance and business-rule blocking before any routing or retrieval.",
  "flow_name": "Intake",
  "version": "1.0.0",
  "entry_point": {
    "module": "agent",
    "factory": "build_agents",
    "entry_agent": "Responsible_AI_Agent",
    "runner": "IntakeGatewayRunner.run"
  },
  "sub_agents": [
    {
      "name": "azure_safety_check",
      "type": "function",
      "purpose": "Deterministic toxicity / PII / prompt-injection pre-check."
    },
    {
      "name": "Responsible_AI_Agent",
      "type": "AssistantAgent",
      "purpose": "LLM governance gate; sets rai_check_passed and next_agent.",
      "max_consecutive_auto_reply": 3
    }
  ],
  "handoff_targets": ["routing_agent", "user_proxy"],
  "dependencies": {
    "python_packages": ["pyautogen", "openai", "python-dotenv"],
    "external_resources": [
      "Azure OpenAI (GPT-4-class chat deployment)"
    ]
  },
  "requires_llm_config": true,
  "configuration_parameters": [
    { "name": "GPT4_LLM_MODEL_DEPLOYMENT_NAME", "secret": false, "required": true },
    { "name": "AZURE_OPENAI_API_BASE", "secret": false, "required": true },
    { "name": "AZURE_OPENAI_API_KEY", "secret": true, "required": true },
    { "name": "AZURE_OPENAI_API_VERSION", "secret": false, "required": true }
  ],
  "statefulness": "build_agents() is a factory — call once per conversation/session."
}
