{
  "agent_id": "grounded_answer",
  "name": "Grounded Answer",
  "role": "Grounded answer synthesis / consolidation",
  "description": "Builds a single grounded draft answer from reconciled SQL (query_answer) and semantic (llm_answer) evidence without inventing facts outside those sources.",
  "flow_name": "Synthesis",
  "version": "1.0.0",
  "entry_point": {
    "module": "agent",
    "factory": "build_agents",
    "entry_agent": "Grounded_Answer_Agent",
    "runner": "GroundedAnswerRunner.run"
  },
  "sub_agents": [
    {
      "name": "Grounded_Answer_Agent",
      "type": "AssistantAgent",
      "purpose": "Consolidate dual-source evidence into final_answer draft.",
      "max_consecutive_auto_reply": 4
    }
  ],
  "handoff_targets": ["response_delivery"],
  "dependencies": {
    "python_packages": ["pyautogen", "openai"],
    "external_resources": ["Azure OpenAI"]
  },
  "requires_llm_config": true,
  "configuration_parameters": [
    { "name": "GPT4_LLM_MODEL_DEPLOYMENT_NAME", "secret": false, "required": true },
    { "name": "AZURE_OPENAI_API_BASE", "secret": false, "required": true },
    { "name": "AZURE_OPENAI_API_KEY", "secret": true, "required": true },
    { "name": "AZURE_OPENAI_API_VERSION", "secret": false, "required": true }
  ],
  "statefulness": "build_agents() is a factory — call once per conversation/session."
}
