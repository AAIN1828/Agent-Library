{
  "agent_id": "evidence_checker",
  "name": "Evidence Checker",
  "role": "Evidence conflict and strength check",
  "description": "Compares structured (SQL) and semantic (document) answers for conflicts, scores groundedness/completeness/faithfulness, and gates whether grounded answer synthesis may proceed.",
  "flow_name": "Evidence",
  "version": "1.0.0",
  "entry_point": {
    "module": "agent",
    "factory": "build_agents",
    "entry_agent": "Evidence_Checker",
    "runner": "EvidenceCheckerRunner.run"
  },
  "sub_agents": [
    {
      "name": "Evidence_Checker",
      "type": "AssistantAgent",
      "purpose": "Reconcile dual-source evidence and set ready_for_synthesis.",
      "max_consecutive_auto_reply": 3
    }
  ],
  "handoff_targets": ["grounded_answer", "Sql_Generator", "Eryl_agent", "user_proxy"],
  "dependencies": {
    "python_packages": ["pyautogen", "openai"],
    "external_resources": ["Azure OpenAI"]
  },
  "requires_llm_config": true,
  "configuration_parameters": [
    { "name": "GPT4_LLM_MODEL_DEPLOYMENT_NAME", "secret": false, "required": true },
    { "name": "AZURE_OPENAI_API_BASE", "secret": false, "required": true },
    { "name": "AZURE_OPENAI_API_KEY", "secret": true, "required": true },
    { "name": "AZURE_OPENAI_API_VERSION", "secret": false, "required": true }
  ],
  "statefulness": "build_agents() is a factory — call once per conversation/session."
}
