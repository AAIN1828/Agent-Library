{
  "agent_id": "eryl_semantic_rag_agent_chain",
  "description": "Message contracts for Eryl's semantic flow. Every agent in this flow is instructed to emit strict JSON (fenced ```json blocks are stripped by callers before json.loads). Fields marked optional may be absent or 'None'.",
  "entrypoint": "ErylChainRunner.run",
  "inputs": [
    "initial_question",
    "analysis_type",
    "sql_query",
    "sql_answer",
    "updated_question"
  ],
  "outputs": [
    "llm_answer",
    "analysis_type",
    "updated_question"
  ],
  "input_schema": {
    "fields": [
      "initial_question",
      "analysis_type",
      "sql_query",
      "sql_answer",
      "updated_question"
    ]
  },
  "output_schema": {
    "fields": [
      "llm_answer",
      "analysis_type",
      "updated_question"
    ]
  },
  "flow_input_contract": {
    "description": "What Eryl expects when entered — either directly from the top-level routing_agent (pure semantic question) or from Quin's evaluation_agent (semantic follow-up after a SQL answer).",
    "type": "object",
    "required": ["initial_question", "analysis_type"],
    "properties": {
      "initial_question": { "type": "string" },
      "analysis_type": { "type": "string", "enum": ["Semantic-based", "Both-dependent", "Both-independent"] },
      "sql_query": { "type": ["string", "null"], "description": "Present on dependent flows entered via query_transformer." },
      "sql_answer": { "type": ["string", "null"] },
      "updated_question": { "type": ["string", "null"] }
    }
  },
  "flow_output_contract": {
    "description": "What Eryl ultimately hands back to user_proxy once critic_agent passes the answer.",
    "type": "object",
    "properties": {
      "initial_question": { "type": "string" },
      "analysis_type": { "type": "string" },
      "updated_question": { "type": "string" },
      "llm_answer": { "type": "string" },
      "post_generation_evaluation": { "$ref": "#/message_contracts/critic_agent/output" }
    }
  },
  "message_contracts": {
    "query_transformer": {
      "output": {
        "type": "object",
        "required": ["initial_question", "analysis_type", "sql_query", "sql_answer", "updated_question", "next_agent"],
        "properties": {
          "initial_question": { "type": "string" },
          "analysis_type": { "type": "string", "description": "Echoed unchanged from routing_agent." },
          "sql_query": { "type": "string" },
          "sql_answer": { "type": "string" },
          "updated_question": { "type": "string", "description": "Refined question focused on the SQL answer's primary insight." },
          "next_agent": { "type": "string", "const": "Eryl_agent" }
        }
      }
    },
    "Eryl_agent": {
      "output": {
        "type": "object",
        "required": ["initial_question", "analysis_type", "sql_query", "sql_answer", "updated_question", "next_agent"],
        "properties": {
          "initial_question": { "type": "string" },
          "analysis_type": { "type": "string" },
          "sql_query": { "type": "string" },
          "sql_answer": { "type": "string" },
          "updated_question": { "type": "string", "description": "Set from critic_agent's feedback_query on retry loops." },
          "next_agent": { "type": "string", "const": "retriever" }
        }
      },
      "tool_call": {
        "name": "extract_context",
        "args": { "question": "string", "vector_weight": "number (default 0.5)", "graph_weight": "number (default 0.5)" }
      }
    },
    "retriever": {
      "output": {
        "type": "object",
        "description": "Result of the extract_context tool call.",
        "oneOf": [
          { "properties": { "vector_context": { "type": "array", "items": { "type": "string" } } } },
          { "properties": { "graph_context": { "type": "string" } } },
          { "properties": { "combined_context": { "type": "string" }, "question": { "type": "string" } } }
        ]
      }
    },
    "llm_answer_maker": {
      "output": {
        "type": "string",
        "description": "Free-text answer grounded strictly in the retrieved context, or the literal sentence 'I do not have enough information to answer this question.' when context is insufficient."
      }
    },
    "critic_agent": {
      "output": {
        "type": "object",
        "required": [
          "question", "Updated_question", "llm_answer",
          "helpfulness", "relevance", "level_of_detail", "groundedness", "completeness", "faithfulness", "content_safety",
          "output_safety", "output_governance", "output_compliance",
          "composite_score", "status", "confidence", "evaluation_timestamp",
          "feedback_query", "feedback_detail"
        ],
        "properties": {
          "question": { "type": "string" },
          "Updated_question": { "type": "string" },
          "llm_answer": { "type": "string" },
          "helpfulness": { "type": "number", "minimum": 0, "maximum": 10 },
          "relevance": { "type": "number", "minimum": 0, "maximum": 10 },
          "level_of_detail": { "type": "number", "minimum": 0, "maximum": 10 },
          "groundedness": { "type": "number", "minimum": 0, "maximum": 10 },
          "completeness": { "type": "number", "minimum": 0, "maximum": 10 },
          "faithfulness": { "type": "number", "minimum": 0, "maximum": 10 },
          "content_safety": { "type": "number", "minimum": 0, "maximum": 10 },
          "output_safety": {
            "type": "object",
            "properties": {
              "pii_leak": { "type": "boolean" },
              "toxic_output": { "type": "boolean" },
              "score": { "type": "number", "minimum": 0, "maximum": 10 }
            }
          },
          "output_governance": {
            "type": "object",
            "properties": {
              "restricted_data_exposed": { "type": "boolean" },
              "score": { "type": "number", "minimum": 0, "maximum": 10 }
            }
          },
          "output_compliance": {
            "type": "object",
            "properties": {
              "policy_violation": { "type": "boolean" },
              "score": { "type": "number", "minimum": 0, "maximum": 10 }
            }
          },
          "composite_score": { "type": "number", "minimum": 0, "maximum": 10, "description": "round(sum(10 scores)/10, 1)" },
          "status": { "type": "string", "enum": ["PASS", "FAIL"] },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "evaluation_timestamp": { "type": "string", "format": "date-time" },
          "blocked_reason": { "type": "string", "description": "Present only when status is FAIL." },
          "feedback_query": { "type": "string", "description": "'None' on PASS; a focused follow-up question on FAIL." },
          "feedback_detail": { "type": "string", "description": "'None' on PASS; gap explanation on FAIL." }
        },
        "trailing_literal_on_pass": "Happy with the answer"
      }
    }
  },
  "routing_rules": {
    "query_transformer": "-> Eryl_agent",
    "Eryl_agent": "-> retriever",
    "retriever": "-> llm_answer_maker",
    "llm_answer_maker": "-> critic_agent",
    "critic_agent": {
      "critic_evaluation_passed(last_message) == true": "-> user_proxy (exits Eryl)",
      "otherwise": "-> Eryl_agent (loop, using feedback_query as the new updated_question)"
    }
  },
  "termination": {
    "critic_agent.is_termination_msg": "True when the raw message contains the literal substring 'Happy with the answer', OR when the JSON-parsed composite score/status computed via compute_post_generation_composite evaluates to PASS."
  }
}
