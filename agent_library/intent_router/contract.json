{
  "agent_id": "intent_router",
  "description": "Routes user questions to SQL (Quin), semantic (Eryl), or both-dependent/independent paths.",
  "entrypoint": "IntentRouterRunner.run",
  "inputs": ["question", "initial_question"],
  "outputs": ["initial_question", "analysis_type", "next_agent", "next_step", "mode", "reason"],
  "input_schema": {
    "fields": ["question", "initial_question"]
  },
  "output_schema": {
    "fields": ["initial_question", "analysis_type", "next_agent", "next_step", "mode", "reason"]
  },
  "flow_input_contract": {
    "type": "object",
    "required": ["initial_question"],
    "properties": {
      "initial_question": { "type": "string" },
      "question": { "type": "string" }
    }
  },
  "flow_output_contract": {
    "type": "object",
    "required": ["initial_question", "analysis_type", "next_agent"],
    "properties": {
      "initial_question": { "type": "string" },
      "analysis_type": {
        "type": "string",
        "enum": ["SQL-based", "Semantic-based", "Both-dependent", "Both-independent"]
      },
      "next_agent": {
        "type": "string",
        "enum": ["Sql_Generator", "Eryl_agent"]
      },
      "next_step": { "type": "string" }
    }
  }
}
