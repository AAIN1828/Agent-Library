{
  "agent_id": "quin_sql_agent_chain",
  "description": "Message contracts for Quin's SQL flow. Every agent in this flow is instructed to emit strict JSON (fenced ```json blocks are stripped by callers before json.loads). Fields marked optional may be absent or 'None'.",
  "entrypoint": "QuinChainRunner.run",
  "inputs": [
    "initial_question",
    "analysis_type",
    "updated_question"
  ],
  "outputs": [
    "query",
    "query_answer",
    "analysis_type",
    "query_results",
    "inference",
    "python_code"
  ],
  "input_schema": {
    "fields": [
      "initial_question",
      "analysis_type",
      "updated_question"
    ]
  },
  "output_schema": {
    "fields": [
      "query",
      "query_answer",
      "analysis_type",
      "query_results",
      "inference",
      "python_code"
    ]
  },
  "flow_input_contract": {
    "description": "What Quin expects when entered, typically from the top-level routing_agent or from Evaluation_Agent (its own) / Eryl's evaluation loop.",
    "type": "object",
    "required": ["initial_question", "analysis_type"],
    "properties": {
      "initial_question": { "type": "string" },
      "analysis_type": {
        "type": "string",
        "enum": ["SQL-based", "Both-dependent", "Both-independent"]
      },
      "updated_question": { "type": ["string", "null"], "description": "Present when re-entering Quin after Eryl or evaluation_agent asked for more structured data." }
    }
  },
  "flow_output_contract": {
    "description": "What Quin ultimately hands back to user_proxy once evaluation_agent marks the answer complete.",
    "type": "object",
    "properties": {
      "initial_question": { "type": "string" },
      "analysis_type": { "type": "string" },
      "db_name": { "type": "string", "const": "SQL" },
      "query": { "type": ["string", "null"] },
      "query_answer": { "type": "string" },
      "query_explanation": { "type": "string" },
      "python_code": { "type": ["string", "null"] },
      "python_code_explanation": { "type": ["string", "null"] },
      "post_generation_evaluation": { "$ref": "#/message_contracts/evaluation_agent/output" }
    }
  },
  "message_contracts": {
    "Sql_Generator": {
      "output": {
        "type": "object",
        "required": ["initial_question", "analysis_type", "sql_question", "sql_query", "db_name", "next_agent"],
        "properties": {
          "initial_question": { "type": "string" },
          "analysis_type": { "type": "string", "description": "Echoed unchanged from routing_agent." },
          "sql_question": { "type": "string" },
          "sql_query": { "type": ["string", "null"], "description": "None when no valid query can be formed from the metadata." },
          "db_name": { "type": "string", "const": "SQL" },
          "next_agent": { "type": "string", "const": "Query_Executor" }
        }
      }
    },
    "Query_Executor": {
      "note": "No structured output contract — reviews the query, then invokes the db_execute_query tool (registered_for_llm) which Sql_tool executes.",
      "tool_call": { "name": "db_execute_query", "args": { "query": "string", "db_name": "string" } }
    },
    "Sql_tool": {
      "output": {
        "type": "string",
        "description": "Raw JSON-records string from db_execute_query, or an 'An error occurred while execusting the query:<e>' string on failure."
      }
    },
    "Sql_Execution_Critic": {
      "output_success": {
        "type": "object",
        "required": ["initial_question", "analysis_type", "sql_question", "sql_query", "db_name", "next_agent", "feedback"],
        "properties": {
          "initial_question": { "type": "string" },
          "analysis_type": { "type": "string" },
          "sql_question": { "type": "string" },
          "sql_query": { "type": "string" },
          "db_name": { "type": "string", "const": "SQL" },
          "next_agent": { "type": "string", "const": "Insight_Generator" },
          "feedback": { "type": "string", "const": "Happy with the result" }
        }
      },
      "output_error": {
        "type": "object",
        "required": ["initial_question", "analysis_type", "sql_question", "sql_query", "next_agent", "db_name", "feedback"],
        "properties": {
          "initial_question": { "type": "string" },
          "analysis_type": { "type": "string" },
          "sql_question": { "type": "string" },
          "sql_query": { "type": "string", "description": "The failing SQL query." },
          "next_agent": { "type": "string", "const": "Sql_Generator" },
          "db_name": { "type": "string", "const": "SQL" },
          "feedback": { "type": "string", "description": "Explanation of the SQL error, for Sql_Generator to act on." }
        }
      }
    },
    "Insight_Generator": {
      "output": {
        "type": "object",
        "required": ["initial_question", "analysis_type", "db_name", "query_question", "query", "query_answer", "Inference", "scores", "feedback", "python_code", "code_explaination"],
        "properties": {
          "initial_question": { "type": "string" },
          "analysis_type": { "type": "string" },
          "db_name": { "type": "string", "const": "SQL" },
          "query_question": { "type": "string" },
          "query": { "type": "string" },
          "query_answer": { "type": "string" },
          "Inference": { "type": "string" },
          "scores": {
            "type": "object",
            "properties": {
              "Helpfulness": { "type": "number", "minimum": 0, "maximum": 10 },
              "Relevance": { "type": "number", "minimum": 0, "maximum": 10 },
              "Level of Detail": { "type": "number", "minimum": 0, "maximum": 10 },
              "Groundedness": { "type": "number", "minimum": 0, "maximum": 10 },
              "Completeness": { "type": "number", "minimum": 0, "maximum": 10 },
              "Faithfulness": { "type": "number", "minimum": 0, "maximum": 10 }
            }
          },
          "feedback": { "type": "string" },
          "python_code": { "type": ["string", "null"], "description": "'None' (string) when no chart applies." },
          "code_explaination": { "type": ["string", "null"] }
        }
      }
    },
    "evaluation_agent": {
      "output": {
        "type": "object",
        "required": [
          "initial_question", "analysis_type", "db_name", "query_question", "query", "query_answer",
          "helpfulness", "relevance", "level_of_detail", "groundedness", "completeness", "faithfulness", "content_safety",
          "output_safety", "output_governance", "output_compliance",
          "composite_score", "status", "confidence", "evaluation_timestamp",
          "feedback", "reasoning", "updated_question", "next_agent", "evaluation_status"
        ],
        "properties": {
          "initial_question": { "type": "string" },
          "analysis_type": { "type": "string" },
          "db_name": { "type": "string", "const": "SQL" },
          "query_question": { "type": "string" },
          "query": { "type": "string" },
          "query_answer": { "type": "string" },
          "helpfulness": { "type": "number", "minimum": 0, "maximum": 10 },
          "relevance": { "type": "number", "minimum": 0, "maximum": 10 },
          "level_of_detail": { "type": "number", "minimum": 0, "maximum": 10 },
          "groundedness": { "type": "number", "minimum": 0, "maximum": 10 },
          "completeness": { "type": "number", "minimum": 0, "maximum": 10 },
          "faithfulness": { "type": "number", "minimum": 0, "maximum": 10 },
          "content_safety": { "type": "number", "minimum": 0, "maximum": 10 },
          "output_safety": {
            "type": "object",
            "properties": {
              "pii_leak": { "type": "boolean" },
              "toxic_output": { "type": "boolean" },
              "score": { "type": "number", "minimum": 0, "maximum": 10 }
            }
          },
          "output_governance": {
            "type": "object",
            "properties": {
              "restricted_data_exposed": { "type": "boolean" },
              "score": { "type": "number", "minimum": 0, "maximum": 10 }
            }
          },
          "output_compliance": {
            "type": "object",
            "properties": {
              "policy_violation": { "type": "boolean" },
              "score": { "type": "number", "minimum": 0, "maximum": 10 }
            }
          },
          "composite_score": { "type": "number", "minimum": 0, "maximum": 10, "description": "round(sum(10 scores)/10, 1)" },
          "status": { "type": "string", "enum": ["PASS", "FAIL"] },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "evaluation_timestamp": { "type": "string", "format": "date-time" },
          "blocked_reason": { "type": "string", "description": "Present only when status is FAIL." },
          "feedback": { "type": "string" },
          "reasoning": { "type": "string" },
          "updated_question": { "type": "string", "description": "'None' when nothing is missing." },
          "next_agent": { "type": "string", "enum": ["user_proxy", "Sql_Generator", "query_transformer"] },
          "evaluation_status": { "type": "integer", "enum": [0, 1] }
        }
      }
    }
  },
  "routing_rules": {
    "Sql_Generator": "-> Query_Executor",
    "Query_Executor": "-> Sql_tool",
    "Sql_tool": "-> Sql_Execution_Critic",
    "Sql_Execution_Critic": {
      "next_agent == 'Insight_Generator'": "-> Insight_Generator",
      "next_agent in ('Sql_Generator','SQL_Generator')": "-> Sql_Generator"
    },
    "Insight_Generator": "-> evaluation_agent",
    "evaluation_agent": {
      "next_agent == 'user_proxy'": "-> user_proxy (exits Quin)",
      "next_agent == 'Sql_Generator'": "-> Sql_Generator (loop)",
      "next_agent == 'query_transformer'": "-> query_transformer (exits Quin, enters Eryl)",
      "evaluation_status == 1 and status == 'PASS' (fallback)": "-> user_proxy",
      "updated_question not in ('none','') (fallback)": "-> query_transformer",
      "default": "-> user_proxy"
    }
  }
}
