{
  "agent_id": "quin_sql_agent_chain",
  "description": "Message contracts for Quin's SQL flow. Agents emit strict JSON (fenced ```json blocks are stripped by callers before json.loads). Schema is introspected live from the DB unless SQL_METADATA is set.",
  "entrypoint": "QuinChainRunner.run",
  "inputs": [
    "initial_question",
    "analysis_type",
    "updated_question"
  ],
  "outputs": [
    "query",
    "query_answer",
    "analysis_type",
    "inference"
  ],
  "input_schema": {
    "fields": [
      "initial_question",
      "analysis_type",
      "updated_question"
    ]
  },
  "output_schema": {
    "fields": [
      "query",
      "query_answer",
      "analysis_type",
      "inference"
    ]
  },
  "flow_input_contract": {
    "description": "What Quin expects when entered. Standalone get_answer() takes a plain question string; QuinChainRunner.run accepts the orchestrator-friendly fields below.",
    "type": "object",
    "required": ["initial_question"],
    "properties": {
      "initial_question": { "type": "string" },
      "analysis_type": {
        "type": "string",
        "enum": ["SQL-based", "Both-dependent", "Both-independent"],
        "description": "Optional; echoed in runner output for pipeline compatibility. Defaults to SQL-based."
      },
      "updated_question": {
        "type": ["string", "null"],
        "description": "When present, used as the question instead of initial_question."
      }
    }
  },
  "flow_output_contract": {
    "description": "What Quin hands back once Insight_Generator finishes.",
    "type": "object",
    "properties": {
      "query": { "type": ["string", "null"] },
      "query_answer": { "type": "string" },
      "analysis_type": { "type": "string" },
      "inference": { "type": "string" }
    }
  },
  "message_contracts": {
    "Sql_Generator": {
      "output": {
        "type": "object",
        "required": ["initial_question", "sql_query", "next_agent"],
        "properties": {
          "initial_question": { "type": "string" },
          "sql_query": {
            "type": ["string", "null"],
            "description": "null when no valid query can be formed from the metadata."
          },
          "next_agent": { "type": "string", "const": "Query_Executor" }
        }
      }
    },
    "Query_Executor": {
      "note": "No structured output contract — reviews the query, then invokes the db_execute_query tool (registered_for_llm) which Sql_tool executes.",
      "tool_call": { "name": "db_execute_query", "args": { "query": "string" } }
    },
    "Sql_tool": {
      "output": {
        "type": "string",
        "description": "Raw JSON-records string from db_execute_query, or an 'An error occurred while executing the query: <e>' string on failure."
      }
    },
    "Sql_Execution_Critic": {
      "output_success": {
        "type": "object",
        "required": ["sql_query", "result", "next_agent", "feedback"],
        "properties": {
          "sql_query": { "type": "string" },
          "result": { "type": "string", "description": "Raw execution result echoed for Insight_Generator." },
          "next_agent": { "type": "string", "const": "Insight_Generator" },
          "feedback": { "type": "string", "const": "Happy with the result" }
        }
      },
      "output_error": {
        "type": "object",
        "required": ["sql_query", "next_agent", "feedback"],
        "properties": {
          "sql_query": { "type": "string", "description": "The failing SQL query." },
          "next_agent": { "type": "string", "const": "Sql_Generator" },
          "feedback": { "type": "string", "description": "Explanation of the SQL error, for Sql_Generator to act on." }
        }
      }
    },
    "Insight_Generator": {
      "output": {
        "type": "object",
        "required": ["query", "query_answer", "inference"],
        "properties": {
          "query": { "type": "string" },
          "query_answer": { "type": "string" },
          "inference": {
            "type": "string",
            "description": "One or two sentences of data-driven insight, if any."
          }
        }
      }
    }
  },
  "routing_rules": {
    "user_proxy": "-> Sql_Generator",
    "Sql_Generator": "-> Query_Executor",
    "Query_Executor": "-> Sql_tool",
    "Sql_tool": "-> Sql_Execution_Critic",
    "Sql_Execution_Critic": {
      "next_agent == 'Insight_Generator'": "-> Insight_Generator",
      "default / parse failure": "-> Sql_Generator"
    },
    "Insight_Generator": "-> user_proxy (exits Quin)"
  }
}
